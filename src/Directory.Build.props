<Project>
  <PropertyGroup>
    <SeoToolkitVersionCommon>6.2.2</SeoToolkitVersionCommon>
    <SeoToolkitVersionMetaFields>6.2.1</SeoToolkitVersionMetaFields>
    <SeoToolkitVersionNotFound>6.2.1</SeoToolkitVersionNotFound>
    <SeoToolkitVersionRedirects>6.2.2</SeoToolkitVersionRedirects>
    <SeoToolkitVersionRobotsTxt>6.2.1</SeoToolkitVersionRobotsTxt>
    <SeoToolkitVersionScriptManager>6.2.1</SeoToolkitVersionScriptManager>
    <SeoToolkitVersionSiteAudit>6.2.1</SeoToolkitVersionSiteAudit>
    <SeoToolkitVersionSitemap>6.2.2</SeoToolkitVersionSitemap>
    <SeoToolkitVersionCore>6.2.3</SeoToolkitVersionCore>
    <SeoToolkitVersionPackage>6.2.3</SeoToolkitVersionPackage>
	<SeoToolkitVersionUsync>1.0.0-beta1</SeoToolkitVersionUsync>
	<SeoToolkitVersionAICore>1.0.0</SeoToolkitVersionAICore>
	<SeoToolkitVersionAIIntegration>1.0.0</SeoToolkitVersionAIIntegration>

    <VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Common'))">$(SeoToolkitVersionCommon)</VersionPrefix>
    <VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.MetaFields'))">$(SeoToolkitVersionMetaFields)</VersionPrefix>
    <VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.NotFound'))">$(SeoToolkitVersionNotFound)</VersionPrefix>
    <VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Redirects'))">$(SeoToolkitVersionRedirects)</VersionPrefix>
    <VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.RobotsTxt'))">$(SeoToolkitVersionRobotsTxt)</VersionPrefix>
    <VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.ScriptManager'))">$(SeoToolkitVersionScriptManager)</VersionPrefix>
    <VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.SiteAudit'))">$(SeoToolkitVersionSiteAudit)</VersionPrefix>
    <VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Sitemap'))">$(SeoToolkitVersionSitemap)</VersionPrefix>
	<VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.uSync'))">$(SeoToolkitVersionUsync)</VersionPrefix>
	<VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('SeoToolkit.Umbraco.AI.Core'))">$(SeoToolkitVersionAICore)</VersionPrefix>
	<VersionPrefix Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('SeoToolkit.Umbraco.AI.Integration'))">$(SeoToolkitVersionAIIntegration)</VersionPrefix>
    <VersionPrefix Condition="'$(MSBuildProjectName)' == 'SeoToolkit.Umbraco.Core'">$(SeoToolkitVersionCore)</VersionPrefix>
    <VersionPrefix Condition="'$(MSBuildProjectName)' == 'SeoToolkit.Umbraco'">$(SeoToolkitVersionPackage)</VersionPrefix>

    <Version>$(VersionPrefix)</Version>
    <PackageVersion>$(Version)</PackageVersion>
  </PropertyGroup>
</Project>
