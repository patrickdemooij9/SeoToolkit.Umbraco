{
  "scripts": {
    "common": "cd SeoToolkit.Umbraco.Common/assets && npm run build",
    "robotsTxt": "cd SeoToolkit.Umbraco.RobotsTxt/assets && npm run build",
    "scriptManager": "cd SeoToolkit.Umbraco.ScriptManager/assets && npm run build",
    "redirect": "cd SeoToolkit.Umbraco.Redirects/assets && npm run build",
    "sitemap": "cd SeoToolkit.Umbraco.Sitemap/assets && npm run build",
    "siteAudit": "cd SeoToolkit.Umbraco.SiteAudit/assets && npm run build",
    "metaFields": "cd SeoToolkit.Umbraco.MetaFields/assets && npm run build",
    "notFound": "cd SeoToolkit.Umbraco.NotFound/assets && npm run build",
    "commonDeploy": "cd SeoToolkit.Umbraco.Common/assets && npm run deploy",
    "robotsTxtDeploy": "cd SeoToolkit.Umbraco.RobotsTxt/assets && npm run deploy",
    "scriptManagerDeploy": "cd SeoToolkit.Umbraco.ScriptManager/assets && npm run deploy",
    "redirectDeploy": "cd SeoToolkit.Umbraco.Redirects/assets && npm run deploy",
    "sitemapDeploy": "cd SeoToolkit.Umbraco.Sitemap/assets && npm run deploy",
    "siteAuditDeploy": "cd SeoToolkit.Umbraco.SiteAudit/assets && npm run deploy",
    "metaFieldsDeploy": "cd SeoToolkit.Umbraco.MetaFields/assets && npm run deploy",
    "notFoundDeploy": "cd SeoToolkit.Umbraco.NotFound/assets && npm run deploy",
    "start": "concurrently \"npm run common\" \"npm run robotsTxt\" \"npm run scriptManager\" \"npm run redirect\" \"npm run sitemap\" \"npm run siteAudit\" \"npm run metaFields\" \"npm run notFound\"",
    "deploy": "concurrently \"npm run commonDeploy\" \"npm run robotsTxtDeploy\" \"npm run scriptManagerDeploy\" \"npm run redirectDeploy\" \"npm run sitemapDeploy\" \"npm run siteAuditDeploy\" \"npm run metaFieldsDeploy\" \"npm run notFoundDeploy\""
  },
  "dependencies": {
    "concurrently": "^9.0.1"
  }
}