# Copy to .env and fill in. .env is gitignored.

# Base URL of the running Umbraco site under test.
# Local dev (see SeoToolkit.Umbraco.Site/Properties/launchSettings.json): https://localhost:44324
URL=https://localhost:44324

# Credentials of a superadmin user on that site.
UMBRACO_USER_LOGIN=acceptance@seotoolkit.local
UMBRACO_USER_PASSWORD=SeoToolkit1234!

# Where the authenticated browser session is cached between tests.
STORAGE_STATE_PATH=playwright/.auth/user.json

# Where @umbraco-cms/acceptance-test-helpers records browser console errors.
CONSOLE_ERRORS_PATH=console-errors.json
